{
  "name": "ai-project-starter-guide-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "pnpm check && pnpm test && pnpm build && node --experimental-strip-types scripts/check-build.ts"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "gray-matter": "^4.0.3",
    "github-slugger": "^2.0.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unist-util-visit": "^5.0.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
